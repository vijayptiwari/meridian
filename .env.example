# LLM (optional — keyword scoring works without a key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Agent runtime
JOB_AGENT_MODE=search
JOB_AGENT_PORTAL=both
JOB_AGENT_HEADED=false
JOB_AGENT_UI_PORT=3030
JOB_AGENT_UI_HOST=127.0.0.1

# Gmail cleanup (optional)
JOB_AGENT_GMAIL_ACTION=preview
JOB_AGENT_GMAIL_QUERY=
JOB_AGENT_GMAIL_MAX_MESSAGES=

# Demo mode writes sample output without portal access
JOB_AGENT_DEMO=false
